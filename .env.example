# =============================================================================
# Distributed Real-Time Video Analytics Pipeline - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=Edge Video Analytics Gateway
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=1

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=edge_analytics

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0

# Redis Stream Names
RAW_FRAME_STREAM=stream:raw_frames
PROCESSED_EVENT_STREAM=stream:processed_events
ALERT_STREAM=stream:alerts
TELEMETRY_STREAM=stream:telemetry

# Consumer Groups
VISION_PIPELINE_GROUP=vision_pipeline_consumers
STREAM_PROCESSOR_GROUP=stream_processor_consumers
WEBSOCKET_GATEWAY_GROUP=websocket_gateway_consumers

# -----------------------------------------------------------------------------
# MinIO / S3 Object Storage
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=minio_password
S3_BUCKET_NAME=anomaly-frames
S3_REGION=us-east-1
S3_SECURE=false

# -----------------------------------------------------------------------------
# Vision Pipeline & Model Configuration
# -----------------------------------------------------------------------------
MODEL_PATH=/models/yolov8n.onnx
MODEL_INPUT_WIDTH=640
MODEL_INPUT_HEIGHT=640
MODEL_CONFIDENCE_THRESHOLD=0.5
MODEL_IOU_THRESHOLD=0.45
USE_CUDA=false
INFERENCE_BATCH_SIZE=4
INFERENCE_NUM_THREADS=0

# -----------------------------------------------------------------------------
# Video Stream Ingestion
# -----------------------------------------------------------------------------
RTSP_STREAM_URL=0
FRAME_SKIP=1
MAX_FRAME_BUFFER_SIZE=30
JPEG_QUALITY=85

# -----------------------------------------------------------------------------
# WebSocket Configuration
# -----------------------------------------------------------------------------
WS_HEARTBEAT_INTERVAL=30
WS_MAX_MESSAGE_SIZE=16777216
WS_COMPRESSION=true

# -----------------------------------------------------------------------------
# Metrics & Monitoring
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json